colour = "grey20"
),
axis.text = element_text(
size = 9,
colour = "grey30"
),
plot.caption = element_text(
hjust = 0,
size = 7,
colour = "grey30",
margin = margin (t = 8)
),
plot.caption.position = "plot",
legend.position = "none"
)
print(fig1_prevalence)
fig1_prevalence <- ggplot(
prevalence_table,
aes(
x = instrument,
y = prevalence_percentage,
fill = instrument
)
) +
geom_col(
width = 0.6
) +
geom_errorbar(
aes(
ymin = ci_lower,
ymax = ci_upper
),
width = 0.15,
linewidth = 0.6
) +
scale_fill_paletteer_d(
"fishualize::Epinephelus_lanceolatus"
) +
scale_x_discrete(
labels = c(
"PSQI > 4 (poor sleep quality)" = "PSQI",
"AIS > 5 (insomnia)" = "AIS",
"Berlin (high SDB risk)" = "BSS",
"ESS > 10 (daytime sleepiness)" = "ESS"
)
) +
scale_y_continuous(
limits = c(0, 100),
expand = expansion(mult = c(0, 0.05))
) +
labs(
x = "Sleep Instrument",
y = "Prevalence (%)",
caption = paste0(
"Cut-offs: PSQI > 4; ESS > 10; AIS > 5.\n",
"BSS = high likelihood of sleep-disordered breathing."
)
) +
theme_minimal(base_size = 12) +
theme(
axis.title = element_text(
size = 10,
colour = "grey20"
),
axis.text = element_text(
size = 8,
colour = "grey30"
),
plot.caption = element_text(
hjust = 0,
size = 7,
colour = "grey30",
margin = margin (t = 8)
),
plot.caption.position = "plot",
legend.position = "none"
)
print(fig1_prevalence)
